---
import Base from '../layouts/Base.astro';
---
<Base title="Oncovô? — Descubra lugares e eventos em BH" description="Encontre bares, restaurantes e eventos em Belo Horizonte. Busca simples com links para as fontes originais.">
  <section class="text-center pt-3 md:pt-5" aria-labelledby="hero-title">
    <span class="inline-flex items-center rounded-full border border-orange-200 bg-orange-50 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-red-700">O seu guia de BH</span>
    <h1 id="hero-title" class="mx-auto mt-5 max-w-2xl text-2xl font-extrabold leading-tight text-neutral-950 md:text-3xl">E aí, <span class="text-red-700">oncovô?</span></h1>
    <p class="mx-auto mt-3 mb-7 max-w-lg text-base leading-7 text-neutral-700 md:text-lg">Descubra bares, restaurantes e rolês em Belo Horizonte. Do jeitinho que cê procura.</p>
    <form id="search-form" role="search" class="mx-auto max-w-2xl rounded-2xl border border-orange-200/80 bg-white/60 p-4 shadow-sm sm:p-5" autocomplete="off">
      <label for="message" class="sr-only">O que quer encontrar em Belo Horizonte?</label>
      <input id="message" name="q" type="search" maxlength="160" minlength="2" enterkeyhint="search" required
        placeholder="Qual rolê tá procurando em BH?"
        class="w-full rounded-xl border-2 border-orange-200 bg-orange-50 px-4 py-4 text-base shadow-inner outline-none placeholder:text-neutral-500 focus:border-red-600 focus:ring-2 focus:ring-orange-200 md:text-lg" />
      <button type="submit" id="search-button" class="mt-4 rounded-xl bg-red-700 px-10 py-3 font-extrabold uppercase tracking-wide text-white shadow-sm hover:bg-red-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-800 disabled:opacity-60">
        Procurar
      </button>
    </form>
    <div id="quick-searches" class="mx-auto mt-5 flex max-w-3xl flex-wrap justify-center gap-2" aria-label="Sugestões">
      <button type="button" class="quick-search" data-query="eventos hoje">Hoje</button>
      <button type="button" class="quick-search" data-query="eventos fim de semana">Fim de semana</button>
      <button type="button" class="quick-search" data-query="gratuito">Gratuito</button>
      <button type="button" class="quick-search" data-query="música ao vivo">Música ao vivo</button>
      <button type="button" class="quick-search" data-query="bar">Bar</button>
      <button type="button" class="quick-search" data-query="restaurante">Restaurante</button>
      <button type="button" class="quick-search" data-query="criança">Família</button>
    </div>
    <div class="mx-auto mt-10 max-w-3xl text-left">
      <p class="mb-3 text-xs font-extrabold uppercase tracking-widest text-neutral-600">Explore do seu jeito</p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <button type="button" data-query="restaurante" class="discovery-tile group">
          <span class="text-2xl" aria-hidden="true">🍽️</span>
          <strong class="mt-2 block text-base text-neutral-900">Comer bem</strong>
          <span class="mt-1 block text-sm text-neutral-600">Restaurantes e delícias</span>
          <span class="tile-action">Procurar →</span>
        </button>
        <button type="button" data-query="música ao vivo" class="discovery-tile group">
          <span class="text-2xl" aria-hidden="true">🎶</span>
          <strong class="mt-2 block text-base text-neutral-900">Curtir um rolê</strong>
          <span class="mt-1 block text-sm text-neutral-600">Música e experiências</span>
          <span class="tile-action">Procurar →</span>
        </button>
        <button type="button" data-query="criança" class="discovery-tile group">
          <span class="text-2xl" aria-hidden="true">☀️</span>
          <strong class="mt-2 block text-base text-neutral-900">Sair em família</strong>
          <span class="mt-1 block text-sm text-neutral-600">Ideias para todo mundo</span>
          <span class="tile-action">Procurar →</span>
        </button>
      </div>
    </div>
  </section>

  <section class="mt-10" aria-label="Resultados da busca">
    <p class="text-center text-sm text-neutral-600 mb-3">Os resultados dependem da nossa base atualizada. Preços, horários e disponibilidade devem ser confirmados na fonte.</p>
    <div id="status" role="status" aria-live="polite" class="rounded-xl bg-orange-50 p-5 text-center text-neutral-800">
      Busque do seu jeito. Ex.: “pagode hoje”, “bar em Santa Tereza”, “hamburger” ou “café na Savassi”.
    </div>
    <div id="results" class="mt-4 grid gap-4"></div>
    <div class="mt-6 text-center">
      <button id="load-more" type="button" hidden class="rounded-lg border border-red-700 px-5 py-2 font-bold text-red-700 hover:bg-red-50">Mostrar mais resultados</button>
    </div>
  </section>
</Base>

<script>
  type Item = {
    id:string;type:'place'|'event';title:string;subtitle:string|null;description:string|null;
    neighborhood:string|null;address:string|null;starts_at:string|null;ends_at:string|null;
    price_label:string|null;tags:string|string[]|null;source_label:string|null;source_url:string|null;
  };
  type Result = { items:Item[]; has_more:boolean; next_offset:number|null; error?:string };
  const form=document.querySelector<HTMLFormElement>('#search-form')!;
  const input=document.querySelector<HTMLInputElement>('#message')!;
  const button=document.querySelector<HTMLButtonElement>('#search-button')!;
  const status=document.querySelector<HTMLDivElement>('#status')!;
  const results=document.querySelector<HTMLDivElement>('#results')!;
  const more=document.querySelector<HTMLButtonElement>('#load-more')!;
  const apiBase=(import.meta.env.PUBLIC_API_URL || (import.meta.env.DEV?'http://localhost:8787':'')).replace(/\/$/,'');
  let currentQuery='';let nextOffset:number|null=null;let controller:AbortController|null=null;
  function el<K extends keyof HTMLElementTagNameMap>(tag:K, classes='', text='') {
    const node=document.createElement(tag);node.className=classes;if(text) node.textContent=text;return node;
  }
  function safeUrl(raw:string|null):string|null {
    if(!raw)return null;
    try {const url=new URL(raw);return url.protocol==='https:' ? url.href : null;}catch{return null;}
  }
  function tagsOf(raw:Item['tags']):string[] {
    if(Array.isArray(raw))return raw.filter(t=>typeof t==='string').slice(0,5);
    if(typeof raw!=='string')return [];
    try {const parsed:unknown=JSON.parse(raw);return Array.isArray(parsed) ? parsed.filter(t=>typeof t==='string').slice(0,5) : [];} catch {return [];}
  }
  function fmtDate(raw:string|null):string {
    if(!raw)return '';
    const date=new Date(raw);
    if(Number.isNaN(date.getTime()))return '';
    return new Intl.DateTimeFormat('pt-BR',{timeZone:'America/Sao_Paulo',day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}).format(date);
  }
  function card(item:Item):HTMLElement {
    const article=el('article','result-card');
    article.setAttribute('aria-label', item.title);
    const head=el('div','flex flex-wrap items-center gap-2');
    head.append(el('span','rounded-full bg-red-700 px-3 py-1 text-xs uppercase font-bold text-white',item.type==='event'?'Evento':'Lugar'));
    if(item.price_label)head.append(el('span','rounded-full bg-orange-100 px-3 py-1 text-xs font-bold text-red-800',item.price_label));
    article.append(head,el('h2','mt-3 text-xl font-extrabold leading-tight tracking-tight md:text-2xl',item.title));
    if(item.subtitle)article.append(el('p','mt-1 text-sm font-semibold text-red-700',item.subtitle));
    if(item.description)article.append(el('p','mt-3 text-sm text-neutral-700 leading-6 clamp-3',item.description));
    const meta=el('div','mt-4 flex flex-wrap gap-2 text-sm text-neutral-700');
    for(const data of [item.neighborhood ? `Bairro: ${item.neighborhood}` : '',item.address||'',
      item.type==='event' && item.starts_at?`Quando: ${fmtDate(item.starts_at)}`:'']) {
      if(data)meta.append(el('span','rounded-md bg-amber-50 px-2 py-1',data));
    }
    if(meta.childElementCount)article.append(meta);
    const tagrow=el('div','mt-4 flex flex-wrap gap-2');
    for(const tag of tagsOf(item.tags))tagrow.append(el('span','rounded-md border border-orange-200 px-2 py-1 text-xs text-red-800',tag));
    if(tagrow.childElementCount)article.append(tagrow);
    const links=el('div','mt-5 flex flex-wrap gap-3');
    const source=safeUrl(item.source_url);
    const mapQuery=[item.address,item.neighborhood,'Belo Horizonte'].filter(Boolean).join(', ');
    const destinations:[string,string,boolean][] = [
      ['Ver fonte original',source||'',false],
      ['Abrir mapa',`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`,Boolean(item.address||item.neighborhood)]
    ];
    for(const [label,url,valid] of destinations) {
      if(!url || (label==='Abrir mapa'&&!valid))continue;
      const link=el('a','inline-flex rounded-lg border border-red-700 px-4 py-2 text-sm font-bold text-red-700 hover:bg-red-50',label);
      link.href=url;link.target='_blank';link.rel='noopener noreferrer';links.append(link);
    }
    if(links.childElementCount)article.append(links);
    return article;
  }
  function setStatus(message:string, visible=true) {status.textContent=message;status.hidden=!visible;}
  async function search(query:string, append=false) {
    const q=query.trim();if(!q)return;
    if(!apiBase){setStatus('Configuração pendente: defina PUBLIC_API_URL na Cloudflare Pages.');return;}
    controller?.abort();const active=new AbortController();controller=active;
    const offset=append?nextOffset??0:0;
    if(!append){results.replaceChildren();nextOffset=null;currentQuery=q;}
    button.disabled=true;more.hidden=true;setStatus(append?'Carregando mais...':'Procurando experiências...');
    try {
      const url=new URL(`${apiBase}/api/search`);
      url.searchParams.set('q',q);url.searchParams.set('limit','20');url.searchParams.set('offset',String(offset));
      const response=await fetch(url.href,{signal:active.signal});
      const data=(await response.json()) as Result;
      if(!response.ok)throw new Error(data.error || `Erro HTTP ${response.status}`);
      const fragment=document.createDocumentFragment();
      for(const item of data.items||[]) fragment.append(card(item));
      results.append(fragment);
      nextOffset=data.next_offset;
      more.hidden=!data.has_more;
      const count=results.childElementCount;
      setStatus(count?`${count} resultado${count===1?'':'s'} exibido${count===1?'':'s'} para “${q}”.`:
        `Nenhum resultado encontrado para “${q}”. Tente um termo mais simples ou outra data.`);
      if(!append){const next=new URL(location.href);next.searchParams.set('q',q);history.replaceState({},'',next);}
    } catch(error){
      if(error instanceof DOMException && error.name==='AbortError')return;
      console.error('Falha na pesquisa',error);
      setStatus('Não foi possível consultar a busca. Confira a conexão e tente novamente.');
    } finally {if(controller===active) button.disabled=false;}
  }
  form.addEventListener('submit',event=>{event.preventDefault();void search(input.value);});
  more.addEventListener('click',()=>{if(nextOffset!==null)void search(currentQuery,true);});
  document.querySelectorAll<HTMLButtonElement>('[data-query]').forEach(chip=>{
    chip.addEventListener('click',()=>{const q=chip.dataset.query||'';input.value=q;void search(q);});
  });
  const initial=new URL(location.href).searchParams.get('q');
  if(initial){input.value=initial;void search(initial);}
</script>
